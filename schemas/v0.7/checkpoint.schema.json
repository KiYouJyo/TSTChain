{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.7:checkpoint",
  "title": "TST Chain Checkpoint v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_id", "ledger_id", "through_sequence", "entry_count", "merkle_root", "previous_checkpoint_hash", "validator_set_id", "finality", "created_at", "approvals", "checkpoint_hash", "schema_version"],
  "properties": {
    "checkpoint_id": {"type": "string", "pattern": "^tst:checkpoint:[A-Za-z0-9._~-]+$"},
    "ledger_id": {"type": "string", "pattern": "^tst:ledger:[A-Za-z0-9._~-]+$"},
    "through_sequence": {"type": "integer", "minimum": 1},
    "entry_count": {"type": "integer", "minimum": 1},
    "merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_checkpoint_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "validator_set_id": {"type": "string", "pattern": "^tst:validator-set:[A-Za-z0-9._~-]+$"},
    "finality": {"const": "quorum_signed"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "approvals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "key_id", "algorithm", "signature"],
        "properties": {
          "actor_id": {"type": "string", "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"},
          "key_id": {"type": "string", "pattern": "^tst:key:[A-Za-z0-9._~-]+$"},
          "algorithm": {"const": "ed25519"},
          "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
        }
      }
    },
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "0.7"}
  }
}
