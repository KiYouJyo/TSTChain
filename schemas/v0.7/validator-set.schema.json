{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.7:validator-set",
  "title": "TST Chain ValidatorSet v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["validator_set_id", "members", "quorum", "status", "schema_version"],
  "properties": {
    "validator_set_id": {"type": "string", "pattern": "^tst:validator-set:[A-Za-z0-9._~-]+$"},
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "key_id", "algorithm", "public_key"],
        "properties": {
          "actor_id": {"type": "string", "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"},
          "key_id": {"type": "string", "pattern": "^tst:key:[A-Za-z0-9._~-]+$"},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
        }
      }
    },
    "quorum": {"type": "integer", "minimum": 1},
    "status": {"enum": ["active", "retired"]},
    "schema_version": {"const": "0.7"}
  }
}
