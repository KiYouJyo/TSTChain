{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.2:credential",
  "title": "TST Chain Credential v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "credential_type",
    "issuer_actor_id",
    "subject_actor_id",
    "claims",
    "issued_at",
    "valid_from",
    "status",
    "schema_version"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "pattern": "^tst:credential:[A-Za-z0-9._~-]+$"
    },
    "credential_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "issuer_actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"
    },
    "subject_actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"
    },
    "claims": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revocation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "schema_version": {
      "const": "0.2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revoked_at"
        ],
        "properties": {
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "valid_until"
        ],
        "properties": {
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    }
  ]
}
