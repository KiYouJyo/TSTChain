{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.3:planning-rule",
  "title": "TST Chain PlanningRule v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "version",
    "rule_type",
    "status",
    "issued_by_actor_id",
    "scope",
    "expression",
    "effective_from",
    "basis_refs",
    "schema_version"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^tst:rule:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "rule_type": {
      "enum": [
        "numeric_constraint",
        "numeric_range",
        "enum_constraint",
        "boolean_constraint",
        "spatial_constraint"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "repealed"
      ]
    },
    "issued_by_actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/numericExpression"
        },
        {
          "$ref": "#/$defs/rangeExpression"
        },
        {
          "$ref": "#/$defs/enumExpression"
        },
        {
          "$ref": "#/$defs/booleanExpression"
        },
        {
          "$ref": "#/$defs/spatialExpression"
        }
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "effective_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ruleRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/basisRef"
      }
    },
    "schema_version": {
      "const": "0.3"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "numeric_constraint"
          }
        },
        "required": [
          "rule_type"
        ]
      },
      "then": {
        "properties": {
          "expression": {
            "$ref": "#/$defs/numericExpression"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "numeric_range"
          }
        },
        "required": [
          "rule_type"
        ]
      },
      "then": {
        "properties": {
          "expression": {
            "$ref": "#/$defs/rangeExpression"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "enum_constraint"
          }
        },
        "required": [
          "rule_type"
        ]
      },
      "then": {
        "properties": {
          "expression": {
            "$ref": "#/$defs/enumExpression"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "boolean_constraint"
          }
        },
        "required": [
          "rule_type"
        ]
      },
      "then": {
        "properties": {
          "expression": {
            "$ref": "#/$defs/booleanExpression"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "spatial_constraint"
          }
        },
        "required": [
          "rule_type"
        ]
      },
      "then": {
        "properties": {
          "expression": {
            "$ref": "#/$defs/spatialExpression"
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "not": {
        "const": "-0"
      },
      "description": "Canonical base-10 decimal: no exponent, no leading zeroes, no trailing fractional zeroes, and no -0."
    },
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "basisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "evidence",
            "plan_artifact",
            "policy",
            "legal_basis",
            "external"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "jurisdiction_refs",
        "object_types",
        "object_ids"
      ],
      "properties": {
        "global": {
          "type": "boolean"
        },
        "jurisdiction_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "uniqueItems": true
        },
        "object_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
          },
          "uniqueItems": true
        }
      }
    },
    "numericExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property_path",
        "operator",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "numeric_constraint"
        },
        "property_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "not": {
            "const": "-0"
          },
          "description": "Canonical base-10 decimal: no exponent, no leading zeroes, no trailing fractional zeroes, and no -0."
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        }
      }
    },
    "rangeExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property_path",
        "operator",
        "lower",
        "upper"
      ],
      "properties": {
        "kind": {
          "const": "numeric_range"
        },
        "property_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "operator": {
          "enum": [
            "between_inclusive",
            "between_exclusive"
          ]
        },
        "lower": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "not": {
            "const": "-0"
          },
          "description": "Canonical base-10 decimal: no exponent, no leading zeroes, no trailing fractional zeroes, and no -0."
        },
        "upper": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "not": {
            "const": "-0"
          },
          "description": "Canonical base-10 decimal: no exponent, no leading zeroes, no trailing fractional zeroes, and no -0."
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        }
      }
    },
    "enumExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property_path",
        "operator",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "enum_constraint"
        },
        "property_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "operator": {
          "enum": [
            "in",
            "not_in"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "booleanExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "property_path",
        "expected"
      ],
      "properties": {
        "kind": {
          "const": "boolean_constraint"
        },
        "property_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "expected": {
          "type": "boolean"
        }
      }
    },
    "spatialExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate",
        "target_object_id"
      ],
      "properties": {
        "kind": {
          "const": "spatial_constraint"
        },
        "predicate": {
          "enum": [
            "intersects",
            "disjoint",
            "within",
            "contains",
            "touches",
            "distance_lte",
            "distance_gte"
          ]
        },
        "target_object_id": {
          "type": "string",
          "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        "distance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "not": {
                "const": "-0"
              },
              "description": "Canonical base-10 decimal: no exponent, no leading zeroes, no trailing fractional zeroes, and no -0."
            },
            "unit": {
              "enum": [
                "metre",
                "kilometre"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "enum": [
                  "distance_lte",
                  "distance_gte"
                ]
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "required": [
              "distance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "enum": [
                  "intersects",
                  "disjoint",
                  "within",
                  "contains",
                  "touches"
                ]
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "not": {
              "required": [
                "distance"
              ]
            }
          }
        }
      ]
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "content_digest"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^tst:rule:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "content_digest": {
          "$ref": "#/$defs/contentDigest"
        }
      }
    }
  }
}
