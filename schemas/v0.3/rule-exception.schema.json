{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.3:rule-exception",
  "title": "TST Chain RuleException v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "rule_ref",
    "subject_object_ids",
    "exception_type",
    "status",
    "issued_by_actor_id",
    "valid_from",
    "basis_refs",
    "schema_version"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^tst:exception:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "rule_ref": {
      "$ref": "#/$defs/ruleRef"
    },
    "subject_object_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
      }
    },
    "exception_type": {
      "enum": [
        "exempt",
        "override",
        "review_required"
      ]
    },
    "override_rule_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ruleRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "revoked",
        "expired"
      ]
    },
    "issued_by_actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/basisRef"
      }
    },
    "schema_version": {
      "const": "0.3"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exception_type": {
            "const": "override"
          }
        },
        "required": [
          "exception_type"
        ]
      },
      "then": {
        "properties": {
          "override_rule_ref": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "override_rule_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "exception_type": {
            "enum": [
              "exempt",
              "review_required"
            ]
          }
        },
        "required": [
          "exception_type"
        ]
      },
      "then": {
        "properties": {
          "override_rule_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "basisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "evidence",
            "plan_artifact",
            "policy",
            "legal_basis",
            "external"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "content_digest"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^tst:rule:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "content_digest": {
          "$ref": "#/$defs/contentDigest"
        }
      }
    }
  }
}
