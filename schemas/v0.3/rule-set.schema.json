{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.3:rule-set",
  "title": "TST Chain RuleSet v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_set_id", "version", "rule_refs", "valid_from", "status", "schema_version"],
  "properties": {
    "rule_set_id": {"type": "string", "pattern": "^tst:ruleset:[A-Za-z0-9._~-]+$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "rule_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^tst:rule:[A-Za-z0-9._~-]+$"}},
    "previous_rule_set_digest": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["algorithm", "digest"], "properties": {"algorithm": {"const": "sha256"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, {"type": "null"}]},
    "valid_from": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "valid_until": {"anyOf": [{"type": "string", "format": "date-time", "pattern": "Z$"}, {"type": "null"}]},
    "status": {"enum": ["draft", "active", "superseded", "revoked"]},
    "schema_version": {"const": "0.3"}
  }
}
