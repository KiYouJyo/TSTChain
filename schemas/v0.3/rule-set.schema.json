{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.3:rule-set",
  "title": "TST Chain RuleSet v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_set_id",
    "version",
    "status",
    "issued_by_actor_id",
    "rule_refs",
    "effective_from",
    "basis_refs",
    "schema_version"
  ],
  "properties": {
    "rule_set_id": {
      "type": "string",
      "pattern": "^tst:ruleset:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "repealed"
      ]
    },
    "issued_by_actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "effective_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/ruleSetRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/basisRef"
      }
    },
    "schema_version": {
      "const": "0.3"
    }
  },
  "$defs": {
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "basisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "evidence",
            "plan_artifact",
            "policy",
            "legal_basis",
            "external"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "content_digest"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^tst:rule:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "content_digest": {
          "$ref": "#/$defs/contentDigest"
        }
      }
    },
    "ruleSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_set_id",
        "version",
        "content_digest"
      ],
      "properties": {
        "rule_set_id": {
          "type": "string",
          "pattern": "^tst:ruleset:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "content_digest": {
          "$ref": "#/$defs/contentDigest"
        }
      }
    }
  }
}
