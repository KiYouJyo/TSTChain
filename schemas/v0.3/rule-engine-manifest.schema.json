{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.3:rule-engine-manifest",
  "title": "TST Chain RuleEngineManifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_id",
    "engine_version",
    "interface_profile",
    "supported_rule_types",
    "supported_input_profiles",
    "deterministic",
    "schema_version"
  ],
  "properties": {
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "interface_profile": {
      "const": "TST-RULE-ENGINE/0.3"
    },
    "supported_rule_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "numeric_constraint",
          "numeric_range",
          "enum_constraint",
          "boolean_constraint",
          "spatial_constraint"
        ]
      }
    },
    "supported_input_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "tst_facts",
          "geojson_ref",
          "geopackage_ref",
          "ifc_ref",
          "tim_ref"
        ]
      }
    },
    "deterministic": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.3"
    }
  }
}
