{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.1:spatial-event",
  "title": "TST Chain SpatialEvent v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "subject_object_id",
    "event_type",
    "new_state_hash",
    "actor_id",
    "timestamp",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^tst:event:[a-z0-9][a-z0-9._:-]{2,120}$"
    },
    "subject_object_id": {
      "type": "string",
      "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "previous_state_hash": {
      "$ref": "#/$defs/nullableDigest"
    },
    "new_state_hash": {
      "$ref": "#/$defs/contentDigest"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^tst:actor:[a-z0-9][a-z0-9._:-]{2,121}$"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tst:[a-z0-9][a-z0-9._:-]{2,127}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tst:evidence:[a-z0-9][a-z0-9._:-]{2,117}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "previous_event_hash": {
      "$ref": "#/$defs/nullableDigest"
    },
    "schema_version": {
      "const": "0.1"
    }
  },
  "$defs": {
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nullableDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/contentDigest"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
