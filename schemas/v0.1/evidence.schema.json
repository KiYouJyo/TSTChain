{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.1:evidence",
  "title": "TST Chain Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "evidence_type",
    "content_digest",
    "schema_version"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^tst:evidence:[a-z0-9][a-z0-9._:-]{2,117}$"
    },
    "evidence_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "source_system": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_uri": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_digest": {
      "$ref": "#/$defs/contentDigest"
    },
    "captured_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tst:actor:[a-z0-9][a-z0-9._:-]{2,121}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/contentDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "0.1"
    }
  },
  "$defs": {
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
