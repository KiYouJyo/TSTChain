{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.1:spatial-object",
  "title": "TST Chain SpatialObject v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "object_type",
    "jurisdiction",
    "schema_version"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
    },
    "object_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "parent_object_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tst:object:[a-z0-9][a-z0-9._:-]{2,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalRef"
      },
      "uniqueItems": true,
      "default": []
    },
    "schema_version": {
      "const": "0.1"
    }
  },
  "$defs": {
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "external_id"
      ],
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "content_digest": {
          "$ref": "#/$defs/contentDigest"
        }
      }
    },
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
