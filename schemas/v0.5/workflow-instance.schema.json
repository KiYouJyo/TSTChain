{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tstchain:schema:v0.5:workflow-instance",
  "title":"TST Chain WorkflowInstance v0.5",
  "type":"object","additionalProperties":false,
  "required":["instance_id","workflow_id","subject_ref","current_state","current_version","updated_at","schema_version"],
  "properties":{
    "instance_id":{"type":"string","pattern":"^tst:wf-instance:[A-Za-z0-9._~-]+$"},
    "workflow_id":{"type":"string","pattern":"^tst:workflow:[A-Za-z0-9._~-]+$"},
    "subject_ref":{"type":"string","minLength":1},
    "current_state":{"type":"string","pattern":"^[a-z][a-z0-9._-]{1,127}$"},
    "current_version":{"type":"string","pattern":"^[1-9][0-9]*$"},
    "updated_at":{"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version":{"const":"0.5"}
  }
}
