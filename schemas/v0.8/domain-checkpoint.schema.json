{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.8:domain-checkpoint",
  "title": "TST Chain DomainCheckpoint v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_checkpoint_id", "domain_id", "local_checkpoint_hash", "commitments", "commitment_root", "previous_domain_checkpoint_hash", "validator_set_id", "finality", "created_at", "approvals", "domain_checkpoint_hash", "schema_version"],
  "properties": {
    "domain_checkpoint_id": {"type": "string", "pattern": "^tst:domain-checkpoint:[A-Za-z0-9._~-]+$"},
    "domain_id": {"type": "string", "pattern": "^tst:domain:[A-Za-z0-9._~-]+$"},
    "local_checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commitments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "domain_id", "checkpoint_hash"],
        "properties": {
          "kind": {"enum": ["local_checkpoint", "domain_checkpoint"]},
          "domain_id": {"type": "string", "pattern": "^tst:domain:[A-Za-z0-9._~-]+$"},
          "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "commitment_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_domain_checkpoint_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "validator_set_id": {"type": "string", "pattern": "^tst:validator-set:[A-Za-z0-9._~-]+$"},
    "finality": {"const": "quorum_signed"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "approvals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "key_id", "algorithm", "signature"],
        "properties": {
          "actor_id": {"type": "string", "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"},
          "key_id": {"type": "string", "pattern": "^tst:key:[A-Za-z0-9._~-]+$"},
          "algorithm": {"const": "ed25519"},
          "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
        }
      }
    },
    "domain_checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "0.8"}
  }
}
