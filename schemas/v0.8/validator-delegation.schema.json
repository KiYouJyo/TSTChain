{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tstchain:schema:v0.8:validator-delegation",
  "title": "TST Chain ValidatorDelegation v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["delegation_id", "issuer_domain_id", "subject_domain_id", "delegated_validator_set_id", "capabilities", "epoch", "valid_from", "valid_until", "supersedes_delegation_hash", "approvals", "delegation_hash", "schema_version"],
  "properties": {
    "delegation_id": {"type": "string", "pattern": "^tst:validator-delegation:[A-Za-z0-9._~-]+$"},
    "issuer_domain_id": {"type": "string", "pattern": "^tst:domain:[A-Za-z0-9._~-]+$"},
    "subject_domain_id": {"type": "string", "pattern": "^tst:domain:[A-Za-z0-9._~-]+$"},
    "delegated_validator_set_id": {"type": "string", "pattern": "^tst:validator-set:[A-Za-z0-9._~-]+$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["checkpoint.sign", "domain_checkpoint.sign", "delegation.issue", "cross_domain_proof.issue"]}
    },
    "epoch": {"type": "integer", "minimum": 1},
    "valid_from": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "valid_until": {"anyOf": [{"type": "string", "format": "date-time", "pattern": "Z$"}, {"type": "null"}]},
    "supersedes_delegation_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "approvals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "key_id", "algorithm", "signature"],
        "properties": {
          "actor_id": {"type": "string", "pattern": "^tst:actor:[A-Za-z0-9._~-]+$"},
          "key_id": {"type": "string", "pattern": "^tst:key:[A-Za-z0-9._~-]+$"},
          "algorithm": {"const": "ed25519"},
          "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
        }
      }
    },
    "delegation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "0.8"}
  }
}
